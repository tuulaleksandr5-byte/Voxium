			"animations": [
				{
					"cow_all_rot.rx": "if(is_glowing, 0, torad(-90))"
				},
				{
					"cow_all_rot.rx": "torad(-90)"
				},
				{
					"cow_belly_t.tx": "(sin(torad(-90)+limb_swing) *limb_speed) ",
					"cow_belly.ry": "(sin(torad(-90)+limb_swing) *limb_speed * 0.05) ",
					"cow_udder.ry": "sin(limb_swing) * limb_speed * 0.2"
				},
				{
					"cow_body.rx": "-sin(age * 0.05) * 0.01 + (sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  *limb_speed * 0.1) + (sin(limb_swing) * (0 - limb_speed * 0.5) * limb_speed * 0.2) ",
					"cow_body.ry": "head_yaw * 0.002",
					"cow_body.rz": "-head_yaw * 0.0008525 + -sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  *limb_speed * 0.1",
					"cow_body_t.tz": "-sin(age * 0.1) * 0.1 + clamp(sin(torad(-90)+limb_swing * 2) * (1 - limb_speed * 0.5)  *limb_speed * 2, -6, 0)",
					"cow_bob_t.tz": "sin(limb_swing * 0.8) * (0 - limb_speed * 0.5) * limb_speed * 3",
					"cow_tail.rx": "-sin(torad(90)+limb_swing * 0.5) *limb_speed * 0.1 ",
					"cow_tail.ry": "-sin(age * 0.3) * 0.3 + sin(age * 0.25) * 0.2 + -sin(limb_swing * 0.5) *limb_speed * 0.3 ",
					"cow_tail_bottom.ry": "-sin(age * 0.3) * 0.3 + sin(age * 0.25) * 0.2 + -sin(limb_swing * 0.5) *limb_speed * 0.3 ",
					"cow_head.tz": " sin(age * 0.15) * 0.1 + clamp(sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  *limb_speed * 2, -6, 0)",
					"cow_head.rx": " head_pitch * 0.01 + sin(age * 0.05) * 0.01 + -sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  *limb_speed * 0.2 +  (-sin(limb_swing) * (0 - limb_speed * 0.5) * limb_speed * 0.2) ",
					"cow_head.rz": "-head_yaw * 0.01 + sin(limb_swing * 0.5) * (1 - limb_speed * 0.5)  *limb_speed * 0.2",
					"cow_head.ry": "head_yaw * 0.0035",
					"cow_head.sx": "if(is_child, torad(115), torad(57.5))",
					"cow_head.sy": "if(is_child, torad(115), torad(57.5))",
					"cow_head.sz": "if(is_child, torad(115), torad(57.5))",
					"cow_ear_left.rz": "clamp(sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  *limb_speed, -6, 0)",
					"cow_ear_right.rz": "-clamp(sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  *limb_speed, -6, 0)"
				},
				{
					"pupil_left_t.tx": "-head_yaw * 0.0035",
					"pupil_right_t.tx": "-head_yaw * 0.0035"
				},
				{
					"cow_leg1_t.rx": " -clamp(sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  * limb_speed * 0.5, -6, 0)",
					"cow_leg1_yaw.rz": "if(head_yaw < 0, head_yaw * 0.00175, -head_yaw * 0.00175)",
					"cow_leg1_t.ty": "clamp(sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5) *limb_speed * 0.5, -6, 0)",
					"cow_leg1_t.tz": "-sin(limb_swing ) * (1 - limb_speed * 0.5)  * limb_speed * 6",
					"cow_leg2_t.rx": "-clamp(-sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  * limb_speed * 0.5, -6, 0)",
					"cow_leg2_yaw.rz": "if(head_yaw < 0, -head_yaw * 0.00175, head_yaw * 0.00175)",
					"cow_leg2_t.ty": "clamp(-sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  *limb_speed * 0.5, -6, 0)",
					"cow_leg2_t.tz": "sin(limb_swing) * (1 - limb_speed * 0.5) * limb_speed * 6",
					"cow_leg3_t.rx": "clamp(-sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5) * limb_speed * 0.5, -6, 0)",
					"cow_leg3_yaw.rz": "if(head_yaw < 0, head_yaw * 0.00175, -head_yaw * 0.00175)",
					"cow_leg3_t.ty": "clamp(-sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5) *limb_speed  * 0.5, -6, 0)",
					"cow_leg3_t.tz": "sin(limb_swing) * (1 - limb_speed * 0.5)  * limb_speed * 6",
					"cow_leg4_t.rx": "clamp(sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5)  * limb_speed * 0.5, -6, 0)",
					"cow_leg4_yaw.rz": "if(head_yaw < 0, -head_yaw * 0.00175, head_yaw * 0.00175)",
					"cow_leg4_t.ty": "clamp(sin(torad(-90)+limb_swing) * (1 - limb_speed * 0.5) *limb_speed * 0.5, -6, 0)",
					"cow_leg4_t.tz": "-sin(limb_swing) * (1 - limb_speed * 0.5) * limb_speed * 6"
