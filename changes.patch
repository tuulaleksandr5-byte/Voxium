+        )
+    }
+
+    fn layer(gpu: &Image, index: usize) -> &[u8] {
+        let bytes = gpu.data.as_ref().unwrap();
+        &bytes[index * (bytes.len() / 36)..][..128 * 128 * 4]
+    }
+
+    fn assert_composition(atlas: &game_render::BlockAtlas, changed: &[(usize, u8, [u8; 4])]) {
