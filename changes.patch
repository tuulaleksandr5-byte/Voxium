+            ("foundation:sand", "foundation:sandstone"),
+        ] {
+            let mut grid = std::array::from_fn(|_| stack(&catalog, input, 1));
+            assert_eq!(book.preview(&grid, &catalog), stack(&catalog, output, 1));
+            grid[3] = None;
+            assert_eq!(book.preview(&grid, &catalog), None);
+        }
+    }
+}
