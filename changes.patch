+            "Нет рецепта · разместите ингредиенты в сетке 2×2".into()
+        }),
+        BorderColor::all(if output.is_some() { AMBER } else { LINE }),
+    ));
+    if let Some(stack) = output {
+        let image = commands
+            .spawn((
+                ImageNode::new(icons.get(stack.item, &game.content, blocks)),
+                Node {
+                    width: px(46),
+                    height: px(46),
+                    ..default()
+                },
+                Pickable::IGNORE,
+            ))
+            .id();
