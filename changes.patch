+            position_type: PositionType::Absolute,
+            right: px(3),
+            bottom: px(1),
+            ..default()
+        });
+    } else {
+        label(commands, result, "—", 20., MUTED);
+    }
+    label(commands, parent, "РЕЗУЛЬТАТ · Shift: всё", 11., MUTED);
